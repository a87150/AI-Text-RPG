# 备份包是 data/ 的副本，不入库
backups/

__pycache__/
*.py[cod]
.venv/
logs/

# 临时脚本与调试输出，不入库
_*.py
_*.txt
i.py
cm.txt
mk_*.py
mk_*.txt

# 工具产物，接入 pytest/ruff/coverage 后不该脏仓库
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 生图工作流是运行时会被导入覆盖的文件，出厂默认留在 .bak 里
